{
    "name": "ivoplas/symfony-foundation-bundle",
    "description": "Foundation bundle for Symfony applications",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Ivo Plas",
            "email": "ivoplas@me.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/config": "^7.2",
        "symfony/dependency-injection": "^7.2",
        "symfony/http-kernel": "^7.2"
    },
    "require-dev": {
        "symfony/framework-bundle": "^7.2",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "IvoPlas\\SymfonyFoundationBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IvoPlas\\SymfonyFoundationBundle\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
